  "detect": [
    {
      "name": "a button counts when it is released",
      "info": {"axes": 2, "buttons": 12, "hats": 1},
      "prompt": [{"k": "b", "i": 3, "v": 1}, {"k": "b", "i": 3, "v": 0}],
      "want": ["", "done:b3"]
    },
    {
      "name": "a release of a button that went down before the prompt is ignored",
      "info": {"axes": 2, "buttons": 12, "hats": 1},
      "prompt": [{"k": "b", "i": 3, "v": 0}],
      "want": [""]
    },
    {
      "name": "a hat counts when pushed to one direction",
