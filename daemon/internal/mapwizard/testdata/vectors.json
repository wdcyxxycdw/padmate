    {"name": "an axis that rests high and goes higher keeps its half", "index": 1, "rest": 20000, "far": 32767, "want": "+a1"},
    {"name": "a stick pushed up from the middle", "index": 1, "rest": 0, "far": 32767, "want": "+a1"},
    {"name": "a stick pushed down from the middle", "index": 1, "rest": 0, "far": -32768, "want": "-a1"},
    {"name": "a small range inside the middle, up", "index": 3, "rest": -8000, "far": 9000, "want": "+a3"},
    {"name": "a small range inside the middle, down", "index": 3, "rest": 9000, "far": -8000, "want": "-a3"},
    {"name": "a zone edge: 16383 is still the middle", "index": 0, "rest": 0, "far": 16383, "want": "+a0"},
    {"name": "a zone edge: 16384 is the top", "index": 0, "rest": -16384, "far": 16384, "want": "+a0"}
