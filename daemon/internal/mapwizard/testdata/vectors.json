      ],
      "prompt": [{"k": "b", "i": 3, "v": 1}, {"k": "b", "i": 3, "v": 0}, {"k": "b", "i": 5, "v": 1}, {"k": "b", "i": 5, "v": 0}],
      "want": ["", "", "", "done:b5"]
