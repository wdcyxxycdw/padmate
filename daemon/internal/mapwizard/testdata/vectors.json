    {"name": "trigger rests at the bottom and is pulled to the middle: the whole range, as a partial pull may be", "index": 2, "rest": -32768, "far": 0, "want": "a2"},
    {"name": "trigger rests at the bottom and is pulled a little past the zone edge", "index": 1, "rest": -32768, "far": -16700, "want": "a1"},
