    {"name": "trigger rests at the bottom and goes to the top", "index": 4, "rest": -32768, "far": 32767, "want": "a4"},
    {"name": "trigger rests at 0 and goes to the top", "index": 5, "rest": 0, "far": 32767, "want": "+a5"},
    {"name": "trigger rests at 0 and goes to the bottom", "index": 5, "rest": 0, "far": -32768, "want": "-a5"},
    {"name": "trigger rests at the top and goes to the bottom", "index": 2, "rest": 32767, "far": -32768, "want": "a2~"},
