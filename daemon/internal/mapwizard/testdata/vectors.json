      "prompt": [{"k": "h", "i": 0, "v": 4}],
      "want": ["done:h0.4"]
    },
    {
      "name": "a hat on a diagonal is rejected, and the next direction counts after the centre",
      "info": {"axes": 0, "buttons": 4, "hats": 1},
      "prompt": [{"k": "h", "i": 0, "v": 3}, {"k": "h", "i": 0, "v": 0}, {"k": "h", "i": 0, "v": 2}],
      "want": ["rejected:diagonal", "", "done:h0.2"]
    },
    {
      "name": "a hat that slides from a diagonal to one direction without the centre does not count",
