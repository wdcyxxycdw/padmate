      "mode": "standard",
      "deadzone": 0.2441,
      "saturation": 0.9766,
      "directionThreshold": 0
    },
    "rs": {
      "mode": "standard",
      "deadzone": 0.2441,
      "saturation": 0.9766,
      "directionThreshold": 0
    },
    "dpad": {
      "mode": "eightWay"
    },
    "lt": {
      "press": 0.061,
      "release": 0.011
    },
    "rt": {
      "press": 0.061,
      "release": 0.011
    }
  },
  "layers": {
