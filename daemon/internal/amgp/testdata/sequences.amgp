<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <stickAxisAssociation index="1" xAxis="1" yAxis="2"/>
    <stickAxisAssociation index="2" xAxis="3" yAxis="4"/>
    <vdpadButtonAssociations index="1">
        <vdpadButtonAssociation axis="0" button="12" direction="1"/>
        <vdpadButtonAssociation axis="0" button="13" direction="4"/>
        <vdpadButtonAssociation axis="0" button="14" direction="8"/>
        <vdpadButtonAssociation axis="0" button="15" direction="2"/>
    </vdpadButtonAssociations>
    <sets>
        <set index="1">
            <button index="1">
                <slots>
                    <slot>
                        <code>0x41</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>100</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>0x42</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
            <button index="2">
                <slots>
                    <slot>
                        <text>hello
world</text>
                        <mode>textentry</mode>
                    </slot>
                </slots>
            </button>
            <button index="3">
                <slots>
                    <slot>
                        <code>0x1000021</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>50</code>
                        <mode>delay</mode>
                    </slot>
                    <slot>
                        <code>1</code>
                        <mode>mousebutton</mode>
                    </slot>
                </slots>
            </button>
            <button index="4">
                <slots>
                    <slot>
                        <code>0x41</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>20000</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>0x42</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
            <button index="10">
                <slots>
                    <slot>
                        <code>0x41</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>500</code>
                        <mode>pause</mode>
                    </slot>
                </slots>
            </button>
            <button index="11">
                <slots>
                    <slot>
                        <text>Hi </text>
                        <mode>textentry</mode>
                    </slot>
                    <slot>
                        <code>0x1000004</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
            <trigger index="5">
                <throttle>positivehalf</throttle>
                <triggerbutton index="2">
                    <slots>
                        <slot>
                            <text></text>
                            <mode>textentry</mode>
                        </slot>
                    </slots>
                </triggerbutton>
            </trigger>
            <trigger index="6">
                <throttle>positivehalf</throttle>
                <triggerbutton index="2">
                    <slots>
                        <slot>
                            <code>0</code>
                            <mode>pause</mode>
                        </slot>
                    </slots>
                </triggerbutton>
            </trigger>
            <button index="8">
                <slots>
                    <slot>
                        <code>200</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>0x43</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>
            <button index="9">
                <slots>
                    <slot>
                        <code>300</code>
                        <mode>hold</mode>
                    </slot>
                    <slot>
                        <code>0x41</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>50</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>0x42</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>50</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <text>tap</text>
                        <mode>textentry</mode>
                    </slot>
                </slots>
            </button>
            <button index="17">
                <slots>
                    <slot>
                        <code>0x41</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>10</code>
                        <mode>pause</mode>
                    </slot>
                    <slot>
                        <code>40</code>
                        <mode>keypress</mode>
                    </slot>
                </slots>
            </button>
        </set>
    </sets>
</gamecontroller>
