{"timeNs":150000000,"kind":"down","device":1,"control":"south"}
{"timeNs":300000000,"kind":"up","device":1,"control":"east"}
{"timeNs":300000000,"kind":"up","device":1,"control":"south"}
{"timeNs":300000000,"kind":"removed","device":1}
