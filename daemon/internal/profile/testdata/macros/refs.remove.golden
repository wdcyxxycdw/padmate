{
  "schemaVersion": 0,
  "name": "宏的引用",
  "script": {"entry": "main.ts", "api": "0.21"},
  "layers": {
    "base": {
      "east": {
        "press": {"type": "keys", "keys": "Ctrl+Z"}
      },
