      "south": {"tap": {"type": "keys", "keys": "B"}},
      "lb": {"press": {"type": "script", "name": "cycleBrush", "args": {"dir": 1}}}
    }
  },
  "common": {
    "guide": {"label": "不相关", "press": {"type": "keys", "keys": "F13"}}
  }
