name "功能键", schemaVersion 1
layer base
	south         /layers/base/south         label "撤销"  press: keys Ctrl+Z tap
layer paint
function key set function:back
	south         /functionKeys/back/south   label "重做"  press: keys Ctrl+Shift+Z tap
	west          /functionKeys/back/west    label ""
	leftshoulder  /functionKeys/back/lb      label ""  press: layer  mode(0)
	dpad.up       /functionKeys/back/dpad.up label ""
function key set function:start
	rt            /functionKeys/start/rt     label "只有名字"
	ls.cw         /functionKeys/start/ls.cw  label ""  press: keys Ctrl+] tap
