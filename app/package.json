{
  "name": "padmate",
  "version": "0.14.0",
  "private": true,
  "description": "Optional desktop UI for padmate",
  "author": "padmate contributors",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "prepare:dev": "node scripts/prepare-dev.mjs",
    "dev": "npm run prepare:dev && electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run prepare:dev && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "prepare:e2e": "node scripts/prepare-e2e.mjs",
    "test:e2e": "npm run build && npm run prepare:e2e && playwright test",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "resedit": "1.7.2",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
