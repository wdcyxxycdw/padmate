{
  "schemaVersion": 1,
  "name": "Painting",
  "analog": {
    "ls": {
      "mode": "fourWay"
    }
  },
  "layers": {
    "base": {
      "ls.left": {
        "label": "Smaller brush"
      },
      "ls.right": {
        "label": "Larger brush"
      },
      "ls.up": {
        "label": "Zoom in"
      },
      "ls.down": {
        "label": "Zoom out"
      },
      "south": {
        "label": "Brush"
      },
      "east": {
        "label": "Eraser"
      },
      "west": {
        "label": "Pan",
        "press": {
          "type": "keys",
          "keys": "Space",
          "mode": "hold"
        }
      },
      "north": {
        "label": "Ctrl",
        "press": {
          "type": "keys",
          "keys": "Ctrl",
          "mode": "hold"
        }
      },
      "leftshoulder": {
        "label": "Undo",
        "press": {
          "type": "keys",
          "keys": "Ctrl+Z",
          "mode": "tap"
        }
      },
      "rightshoulder": {
        "label": "Redo"
      },
      "leftstick": {
        "label": "Flip canvas horizontally"
      }
    }
  }
}
