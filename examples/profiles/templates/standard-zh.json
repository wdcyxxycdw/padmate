{
  "schemaVersion": 1,
  "name": "绘画",
  "analog": {
    "ls": {
      "mode": "fourWay"
    }
  },
  "layers": {
    "base": {
      "lt": {
        "label": "抓手",
        "press": {
          "type": "keys",
          "keys": "Space",
          "mode": "hold"
        }
      },
      "leftshoulder": {
        "label": "Ctrl",
        "press": {
          "type": "keys",
          "keys": "Ctrl",
          "mode": "hold"
        }
      },
      "dpad.left": {
        "label": "撤销",
        "press": {
          "type": "keys",
          "keys": "Ctrl+Z",
          "mode": "tap"
        }
      },
      "dpad.right": {
        "label": "重做"
      },
      "dpad.up": {
        "label": "画笔"
      },
      "dpad.down": {
        "label": "橡皮"
      },
      "ls.left": {
        "label": "笔刷缩小"
      },
      "ls.right": {
        "label": "笔刷放大"
      },
      "ls.up": {
        "label": "画布放大"
      },
      "ls.down": {
        "label": "画布缩小"
      },
      "rightshoulder": {
        "label": "Shift",
        "press": {
          "type": "keys",
          "keys": "Shift",
          "mode": "hold"
        }
      },
      "rt": {
        "label": "Alt",
        "press": {
          "type": "keys",
          "keys": "Alt",
          "mode": "hold"
        }
      },
      "south": {
        "label": "自由变换",
        "press": {
          "type": "keys",
          "keys": "Ctrl+T",
          "mode": "tap"
        }
      },
      "north": {
        "label": "新建图层"
      },
      "east": {
        "label": "水平翻转画布"
      }
    }
  }
}
